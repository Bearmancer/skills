#!/bin/sh
# Run the skill's own checks when a commit touches research-rigorously/.
# POSIX sh: git for Windows runs hooks with sh.
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"
if git diff --cached --name-only | grep -q '^research-rigorously/'; then
  uv run research-rigorously/rr.py selfcheck
fi
